@page "/events/create"
@using System.Text.Json.Nodes

<div class="row mb-5">
    <div class="col-lg-8">
        <h1 class="mb-3">New Event</h1>

        @* In case of any exception, show generic error message. *@
        <div class="row mb-3">
            <div class="col-md-8 offset-md-4">
                <span class="text-danger">@GeneralErrorMassage</span>
                <span></span>
            </div>
        </div>


        @*  Title *@
        <div class="row mb-3">
            <label class="col-md-4 col-form-label">Title</label>
            <div class="col-md-8">
                <input class="form-control" @bind="EventDtoData.Title">
                @* Step 6.7.4: Show the API error response for Title *@
                <span class="text-danger">@Errors["Title"]?[0]</span>
            </div>
        </div>

        @*  Start Date *@
        <div class="row mb-3">
            <label class="col-md-4 col-form-label">Start Date</label>
            <div class="col-md-8">
                <input type="datetime-local" class="form-control" @bind="EventDtoData.StartDate">
                @* Step 6.7.4: Show the API error response for StartDate *@
                <span class="text-danger">@Errors["StartDate"]?[0]</span>
            </div>
        </div>

        @*  End Date *@
        <div class="row mb-3">
            <label class="col-md-4 col-form-label">End Date</label>
            <div class="col-md-8">
                <input type="datetime-local" class="form-control" @bind="EventDtoData.EndDate">
                @* Step 6.7.4: Show the API error response for EndDate *@
                <span class="text-danger">@Errors["EndDate"]?[0]</span>
            </div>
        </div>

        @*  Description *@
        <div class="row mb-3">
            <label class="col-md-4 col-form-label">Description</label>
            <div class="col-md-8">
                <textarea class="form-control" @bind="EventDtoData.Description"></textarea>
                @* Step 6.7.4: Show the API error response for Description *@
                <span class="text-danger">@Errors["Description"]?[0]</span>
            </div>
        </div>

        @*  All Day *@
        <div class="row mb-3">
            <div class="col-md-8 offset-md-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="gridCheck1" @bind="EventDtoData.AllDay">
                    <label class="form-check-label" for="gridCheck1">All Day</label>
                </div>
            </div>
        </div>

        @* Save and Cancel Buttons *@
        <div class="row">
            <div class="offset-md-4 col-md-4 d-grid">
                <button class="btn btn-primary" @onclick="SaveEvent">Save</button>
            </div>
            <div class="col-md-4 d-grid">
                <a class="btn btn-outline-primary" href="/Events">Cancel</a>
            </div>

        </div>


    </div>
</div>

@* HttpClient:
 * HttpClient can only be injected inside 'Typed clients'. 
 * Typed clients are dedicated custom classes or interfaces that wrap around 
 * an HttpClient to provide a strongly typed, domain-specific way to handle web requests. 
*@
@inject HttpClient http
@* NavigationManager service to navigate *@
@inject NavigationManager navManager


<Component />
@code {

    private EventDto EventDtoData { set; get; } = new();

    /*
     * Step 6.7.4:New property to store Api Json validation errors
     */
    private JsonNode Errors { set; get; } = new JsonObject();

    private string GeneralErrorMassage { set; get; } = string.Empty;
    /// <summary>
    /// Call at click of Save Button
    /// </summary>
    /// <returns></returns>
    private async Task SaveEvent()
    {
        GeneralErrorMassage = string.Empty;
        /*
        * await:=>The await operator suspends evaluation of the enclosing async method until the asynchronous operation represented by its operand completes.
             * When the asynchronous operation completes, the await operator returns the result of the operation
             * http.PostAsJsonAsync:=> Sends a POST request to the specified Uri containing the value serialized as JSON in the request body.
             */
        try
        {
            var response = await http.PostAsJsonAsync("api/Events", EventDtoData);
            if (response.IsSuccessStatusCode)
            {
                navManager.NavigateTo("/Events");
            }
            else
            {
                var strResponse = await response.Content.ReadAsStringAsync();
                Console.WriteLine("Json Response: \n" + strResponse);
                
                //Step 6.7.4:Extract the error message from Api response.
                var jsonResponse = JsonNode.Parse(strResponse);
                Errors = jsonResponse?["errors"] ?? new JsonObject();

            }
        }
        catch (Exception ex)
        {
            // Display generic error message in case of Exception.
            GeneralErrorMassage = "Technical Error, contact Event management application support team (Support@EventManagement.com)";

        }



    }
}
